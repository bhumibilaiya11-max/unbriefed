# Copy this file to .env and fill in your own values. Never commit the real .env.

# Required — get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# The Groq model to use. openai/gpt-oss-120b is a solid default; pick any chat model your
# account has access to (check with a GET to https://api.groq.com/openai/v1/models).
GROQ_MODEL=openai/gpt-oss-120b

# Local dev server port (ignored on Vercel).
PORT=5173

# Supabase project (Settings -> API in the Supabase dashboard). Powers Google sign-in and the
# credits system. SUPABASE_URL/ANON_KEY are also hardcoded in app.js (they're public by design —
# Row Level Security on the `profiles` table is what actually protects data), so the .env copies
# here are mainly for the server-side calls in api/_supabase.js.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret — server-side only, bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Settings -> API Keys). Powers the "buy credits" checkout flow. India-native — no
# invite needed, individual signup supported, supports UPI.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A secret you choose yourself when creating the webhook (Settings -> Webhooks -> Add New
# Webhook), pointed at POST /api/razorpay-webhook, subscribed to the payment.captured event.
RAZORPAY_WEBHOOK_SECRET=
